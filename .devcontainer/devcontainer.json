{
    "name": "marloth-strategy",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "8.0",
            "dotnetRuntimeVersions": "8.0"
        }
    },
    "mounts": [
        "source=${localEnv:HOME}/dev/minimap,target=/workspaces/minimap,type=bind,consistency=cached"
    ],
    "customizations": {
        "vscode": {
            "extensions": [],
            "settings": {
                "files.eol": "\n"
            }
        }
    }
}
